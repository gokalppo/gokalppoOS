{
  "rules": {
    "users": {
      ".indexOn": [
        "username"
      ],
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ((auth.uid === $uid && newData.child('role').val() === data.child('role').val() && newData.child('isBanned').val() === data.child('isBanned').val()) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "role": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "isBanned": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "email": {
          ".validate": false
        },
        "friends": {
          "$friendUid": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $friendUid && (data.exists() || root.child('friendRequests').child($friendUid).child($uid).exists())))",
            ".validate": "newData.hasChildren(['uid'])",
            "id": {
              ".validate": "newData.val() === $friendUid"
            },
            "uid": {
              ".validate": "newData.val() === $friendUid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "status": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "unreadCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "lastReadAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "latestNudge": {
          ".write": "auth != null && newData.child('senderUid').val() === auth.uid && root.child('users').child($uid).child('friends').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['senderUid', 'senderName', 'timestamp'])",
          "senderUid": {
            ".validate": "newData.isString()"
          },
          "senderName": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "isProcessed": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "lastMessageAt": {
          ".validate": "newData.val() === now"
        },
        "uid": {
          ".validate": "newData.val() === $uid"
        },
        "username": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "isGuest": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "messages": {
      "$room": {
        ".read": "auth != null",
        "$msgId": {
          ".write": "auth != null && (!data.exists() ? (newData.child('senderUid').val() === auth.uid && newData.parent().parent().parent().child('users').child(auth.uid).child('lastMessageAt').val() === now && (!root.child('users').child(auth.uid).child('lastMessageAt').exists() || root.child('users').child(auth.uid).child('lastMessageAt').val() < now - 900)) : root.child('users').child(auth.uid).child('role').val() === 'admin')",
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "senderName": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40 && newData.val() === root.child('users').child(auth.uid).child('username').val()"
          },
          "timestamp": {
            ".validate": "newData.val() === now"
          },
          ".validate": "newData.hasChildren(['senderUid', 'senderName', 'timestamp'])",
          "senderUid": {
            ".validate": "newData.val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'"
          },
          "type": {
            ".validate": "newData.val() === 'nudge'"
          },
          "isDeleted": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        ".validate": "$room.matches(/^global-[0-9]{1,2}$/)"
      }
    },
    "privateMessages": {
      "$roomId": {
        ".read": "auth != null && $roomId.contains(auth.uid)",
        "$msgId": {
          ".write": "auth != null && $roomId.contains(auth.uid) && (!data.exists() ? (newData.child('senderUid').val() === auth.uid && newData.parent().parent().parent().child('users').child(auth.uid).child('lastMessageAt').val() === now && (!root.child('users').child(auth.uid).child('lastMessageAt').exists() || root.child('users').child(auth.uid).child('lastMessageAt').val() < now - 900)) : root.child('users').child(auth.uid).child('role').val() === 'admin')",
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "senderName": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40 && newData.val() === root.child('users').child(auth.uid).child('username').val()"
          },
          "timestamp": {
            ".validate": "newData.val() === now"
          },
          ".validate": "newData.hasChildren(['senderUid', 'senderName', 'timestamp'])",
          "senderUid": {
            ".validate": "newData.val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'"
          },
          "type": {
            ".validate": "newData.val() === 'nudge'"
          },
          "isDeleted": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        ".validate": "$roomId.matches(/^[A-Za-z0-9]{1,40}_[A-Za-z0-9]{1,40}$/)"
      }
    },
    "typing": {
      "$roomId": {
        ".read": "auth != null && $roomId.contains(auth.uid)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $roomId.contains(auth.uid)",
          ".validate": "newData.val() === true"
        },
        ".validate": "$roomId.matches(/^[A-Za-z0-9]{1,40}_[A-Za-z0-9]{1,40}$/)"
      }
    },
    "friendRequests": {
      "$targetUid": {
        ".read": "auth != null && auth.uid === $targetUid",
        "$fromUid": {
          ".read": "auth != null && (auth.uid === $fromUid || auth.uid === $targetUid)",
          ".write": "auth != null && ((auth.uid === $fromUid && auth.token.firebase.sign_in_provider !== 'anonymous') || (auth.uid === $targetUid && !newData.exists() && data.exists()))",
          ".validate": "newData.hasChildren(['fromUid', 'fromName', 'status']) && newData.child('fromUid').val() === $fromUid",
          "fromUid": {
            ".validate": "newData.isString()"
          },
          "fromName": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40 && newData.val() === root.child('users').child($fromUid).child('username').val()"
          },
          "status": {
            ".validate": "newData.val() === 'pending'"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "declinedHistory": {
      "$deciderUid": {
        "$otherUid": {
          ".read": "auth != null && (auth.uid === $deciderUid || auth.uid === $otherUid)",
          ".write": "auth != null && auth.uid === $deciderUid",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "userPrivate": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 254"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "outbox": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": [
        "timestamp"
      ],
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['from', 'to', 'subject', 'body', 'timestamp'])",
        "from": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "to": {
          ".validate": "newData.val() === 'gokalppoos@gmail.com'"
        },
        "subject": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        },
        "sentVia": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "readAt": {
          ".validate": "newData.isNumber() && auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "botTaught": {
      "approved": {
        ".read": true,
        "$id": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.hasChildren(['q', 'a', 'lang', 'approvedAt'])",
          "q": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80"
          },
          "a": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 200"
          },
          "lang": {
            ".validate": "newData.val() === 'en' || newData.val() === 'tr'"
          },
          "approvedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "pending": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".indexOn": [
          "timestamp"
        ],
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid && newData.parent().parent().parent().child('botTeachMeta').child(auth.uid).child('lastAt').val() === now && (!root.child('botTeachMeta').child(auth.uid).child('lastAt').exists() || root.child('botTeachMeta').child(auth.uid).child('lastAt').val() < now - 10000)) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "newData.hasChildren(['q', 'a', 'lang', 'uid', 'timestamp'])",
          "q": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80"
          },
          "a": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 200"
          },
          "lang": {
            ".validate": "newData.val() === 'en' || newData.val() === 'tr'"
          },
          "uid": {
            ".validate": "newData.isString()"
          },
          "timestamp": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "botTeachMeta": {
      "$uid": {
        "lastAt": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === now"
        }
      }
    },
    "siteStats": {
      "visitorCount": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      }
    },
    "analytics": {
      "appOpens": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$app": {
          ".write": "$app.matches(/^(mycomputer|recyclebin|notepad|myresume|terminal|gallery|contact|minesweeper|musicplayer|paint|internetexplorer|guestbook|solitaire|aboutme|messenger|systemproperties|displayproperties|welcome|documents)$/)",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      }
    },
    "guestbook": {
      ".read": true,
      ".indexOn": [
        "timestamp"
      ],
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['name', 'message', 'timestamp'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 280"
        },
        "timestamp": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "leaderboards": {
      "minesweeper": {
        ".read": true,
        ".indexOn": [
          "time"
        ],
        "$id": {
          ".write": "$id.matches(/^[a-z0-9-]{1,20}$/) && newData.exists() && (!data.exists() || newData.child('time').val() < data.child('time').val())",
          ".validate": "newData.hasChildren(['name', 'time', 'timestamp'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "time": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999 && newData.val() % 1 === 0"
          },
          "timestamp": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
