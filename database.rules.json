{
  "rules": {
    "users": {
      ".indexOn": ["username"],
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "role": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "isBanned": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "email": {
          ".validate": false
        },
        "friends": {
          "$friendUid": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $friendUid && (data.exists() || root.child('friendRequests').child($friendUid).child($uid).exists())))"
          }
        },
        "latestNudge": {
          ".write": "auth != null && newData.child('senderUid').val() === auth.uid"
        }
      }
    },

    "messages": {
      "$room": {
        ".read": "auth != null",
        "$msgId": {
          ".write": "auth != null && (!data.exists() ? newData.child('senderUid').val() === auth.uid : root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      }
    },

    "privateMessages": {
      "$roomId": {
        ".read": "auth != null && $roomId.contains(auth.uid)",
        "$msgId": {
          ".write": "auth != null && $roomId.contains(auth.uid) && (!data.exists() ? newData.child('senderUid').val() === auth.uid : root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      }
    },

    "typing": {
      "$roomId": {
        ".read": "auth != null && $roomId.contains(auth.uid)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $roomId.contains(auth.uid)",
          ".validate": "newData.val() === true"
        }
      }
    },

    "friendRequests": {
      "$targetUid": {
        ".read": "auth != null && auth.uid === $targetUid",
        "$fromUid": {
          ".read": "auth != null && (auth.uid === $fromUid || auth.uid === $targetUid)",
          ".write": "auth != null && (auth.uid === $fromUid || auth.uid === $targetUid)"
        }
      }
    },

    "declinedHistory": {
      "$deciderUid": {
        "$otherUid": {
          ".read": "auth != null && (auth.uid === $deciderUid || auth.uid === $otherUid)",
          ".write": "auth != null && auth.uid === $deciderUid"
        }
      }
    },

    "userPrivate": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "outbox": {
      ".read": false,
      ".write": "auth != null"
    },

    "siteStats": {
      "visitorCount": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      }
    },

    ".read": false,
    ".write": false
  }
}
